# Copiá este archivo a .env.local y completá los valores.
# En producción (Vercel) estas mismas variables se cargan en
# Project Settings → Environment Variables (ver DEPLOY.md).

# Local: mongodb://127.0.0.1:27017/cultivo_hongos
# Atlas: mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/cultivo_hongos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cultivo_hongos

# Secreto para firmar las sesiones (JWT). Generalo con: openssl rand -hex 32
# Usá uno distinto en producción; si lo cambiás, todos vuelven a loguearse.
JWT_SECRET=

# ¿Se pueden crear cuentas nuevas? "true" = abierto; cualquier otro valor =
# cerrado. Sin definir: abierto en desarrollo y CERRADO en producción.
# En producción, ponelo en "true" solo para crear tu cuenta y después sacalo.
REGISTRO_HABILITADO=

# Monitoreo (InfluxDB 2.x / Cloud, API v2). Solo se usan del lado del
# servidor: el token NUNCA se manda al navegador ni se escribe en logs.
# Necesita permiso de lectura sobre el bucket.
INFLUX_URL=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_TOKEN=
